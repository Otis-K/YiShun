{
  "name": "@flowcanvas/sdk",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Embeddable frontend node canvas and DAG workflow SDK",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/flowcanvas.iife.js",
  "jsdelivr": "./dist/flowcanvas.iife.js",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "demo/standalone",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./flowcanvas.iife": "./dist/flowcanvas.iife.js",
    "./flowcanvas.iife.js": "./dist/flowcanvas.iife.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && pnpm build:library && pnpm build:browser && pnpm build:types",
    "build:library": "vite build --mode library",
    "build:browser": "vite build --mode browser",
    "build:types": "tsc -p tsconfig.types.json && node scripts/finalize-types.mjs",
    "check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:go-backend": "pnpm build && node scripts/verify-go-backend-runtime.mjs",
    "test:package": "node scripts/package-consumer.mjs",
    "test:packaging": "pnpm build && pnpm test:package && playwright test --config playwright.packaging.config.ts"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "39.8.2",
    "jsdom": "26.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.1.5"
  }
}
