# Optional server-side model configuration. Never commit real API keys.
FLOWCANVAS_IMAGE_MODEL_API_KEY=
FLOWCANVAS_IMAGE_MODEL_BASE_URL=https://api.tmlab.store
FLOWCANVAS_IMAGE_MODEL_ID=nano-banana-pro(特价版 1)

FLOWCANVAS_VIDEO_MODEL_API_KEY=
FLOWCANVAS_VIDEO_MODEL_BASE_URL=https://api.tmlab.store
FLOWCANVAS_VIDEO_MODEL_ID=seedance-2.0-pro(431)

YISHUN_WEB_HOST=127.0.0.1
YISHUN_WEB_PORT=4174

# QQ 互联网站应用配置。复制需要的内容到 .env.local，禁止提交真实 App Key。
QQ_CONNECT_APP_ID=
QQ_CONNECT_APP_KEY=
QQ_CONNECT_REDIRECT_URI=https://example.com/api/auth/qq/callback
YISHUN_PUBLIC_ORIGIN=https://example.com
AUTH_COOKIE_SECURE=true
